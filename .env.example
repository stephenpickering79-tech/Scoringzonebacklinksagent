# Scoring Zone Backlinks Agent - Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env
# The agent will load this via python-dotenv for local runs.

# === Required for GitHub-hosted agent (add these as repo secrets too) ===
# Steel.dev API key - for browser automation and form submissions/captcha bypass
STEEL_API_KEY=your_steel_key_here

# OpenRouter API key - for LLM scoring of discovered candidates (relevance scoring)
OPENROUTER_API_KEY=your_openrouter_key_here
# OpenRouter model id (optional). Default: google/gemini-3.1-flash-lite
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Serper.dev API key - for web-search discovery of NEW directories/listing targets.
# Without it the agent still runs (curated list + roundup scrape); with it, each daily run
# searches Google for new submission opportunities. Get a key at https://serper.dev
SERPER_API_KEY=your_serper_key_here

# GitHub token (PAT or the default GITHUB_TOKEN) with repo:write and issues:write
# For custom PAT (recommended for full control): fine-grained with Contents: Read&write, Issues: Read&write
GH_TOKEN=your_github_token_here

# === Agent behavior ===
AGENT_MODE=propose   # "propose" (daily research+review) or "submit" (execute approved)
DRY_RUN=true         # true = don't actually submit, just log
MAX_CANDIDATES_PER_DAY=50
MAX_SUBMISSIONS_PER_DAY=5

# For submit mode: comma-separated list of approved targets from the proposal issue
APPROVED_TARGETS=

# === Dashboard "Approve" button → submit (see backlink_agent/submitter.py) ===
# Clicking Approve queues the target AND, when enabled, the agent submits it immediately
# in the background (scripted site → its script; any other site → the generic best-effort
# submitter). The Approved tab shows Submitting… → Submitted / Manual submit / Error.
#
# Master switch. false = approvals just queue (you submit by hand). true = the agent
# submits on Approve. Requires STEEL_API_KEY (the browser automation).
AUTO_SUBMIT_ENABLED=false
# Dry-run DEFAULTS TO TRUE (safe): the agent fills the form but does NOT click submit.
# Set to false ONLY when you want real submissions.
AUTO_SUBMIT_DRY_RUN=true
# Max real auto-submissions per day (link-velocity safety; keep it low). Default 3.
MAX_AUTOSUBMITS_PER_DAY=3
# Secret for the Approve/Dismiss buttons. When set, /api/approve requires it (header
# X-Approve-Token or ?k=). Load the dashboard as  https://<host>/?k=YOURTOKEN  so the
# buttons work; random visitors/bots without it get 401. Leave blank = unauthenticated.
APPROVE_TOKEN=
# Optional: a Slack-style incoming webhook URL. If set, the agent POSTs an alert here when a
# daily run fails or a submission errors (observability). Leave blank to disable.
ALERT_WEBHOOK_URL=
# SAFETY MODEL: approval = authorization. Clicking Approve on the dashboard IS the human
# review, so the agent attempts every approved target (scripted script or generic submitter).
# The remaining controls are APPROVE_TOKEN, MAX_AUTOSUBMITS_PER_DAY, and AUTO_SUBMIT_DRY_RUN.
#
# Account-required sites (Product Hunt etc.) are fully autonomous: when the agent hits a
# signup/login wall with no stored login, it CREATES its own account (generates a password,
# registers with CONTACT_EMAIL, stores the login in Steel's encrypted Credentials API,
# completes email verification, then submits). Passwords never go in this file, Railway vars,
# the repo, logs, or screenshots. The authenticated profile is reused on later runs via
# data/steel_profiles.json; created accounts are logged (passwordless) in data/accounts.json.
# You can still pre-seed a login manually:  python3 manage_credentials.py add https://example.com

# Gmail app password for reading verification emails (the ONE secret that makes account
# creation autonomous — covers every site, set once). Generate at
# myaccount.google.com/apppasswords (requires 2-step verification on the Google account).
# Without it the agent still creates accounts but can't click "confirm your email" links, so
# verification-gated listings won't activate. Optional: IMAP_EMAIL (defaults to CONTACT_EMAIL).
IMAP_PASSWORD=
# IMAP_EMAIL=stephenpickering79@gmail.com

# Live-link verification (backlink_agent/livecheck.py): the daily sweep checks pending
# submissions for a live scoringzone.net link (plain HTTP first, free). Steel cheap-scrape
# is only used as a fallback for JS-rendered / bot-walled pages — this caps those per run.
LIVECHECK_MAX_STEEL_PER_RUN=5

# CURRENT PHASE: only surface targets the agent can submit to itself (forms / self-serve
# profiles). LLM-scored discoveries marked email/none (articles, newsletters, editorial =
# outreach targets, see TODO.md) are hidden to data/rejected_*.json. Set false to surface
# outreach-type discoveries again when the outreach phase starts.
SUBMITTABLE_ONLY=true

# Optional: for local gh CLI testing of issue creation (use fine-grained PAT)
# GITHUB_TOKEN=ghp_...

# Note: In GitHub Actions, use repo secrets with the same names (STEEL_API_KEY, OPENROUTER_API_KEY, GH_TOKEN).
# The default GITHUB_TOKEN works for basic cases but custom PAT gives more control.
